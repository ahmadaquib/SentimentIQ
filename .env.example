# ============================================================
# SentimentIQ — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Server Configuration ---
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# --- HuggingFace Configuration ---
# Get your token at: https://huggingface.co/settings/tokens
# Required for faster downloads and higher rate limits.
HF_TOKEN=your_huggingface_token_here

# --- Sarcasm Model ---
# Model ID from HuggingFace Hub for sarcasm/irony detection.
SARCASM_MODEL=helinivan/english-sarcasm-detector

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Data Paths (relative to project root) ---
MODELS_DIR=models
DATA_DIR=data
PREDICTIONS_CSV=data/predictions.csv
